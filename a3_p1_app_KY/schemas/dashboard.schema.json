{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/schemas/streamlit-dashboard.schema.json",
  "title": "Streamlit dashboard assessment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dashboard",
    "sources",
    "datasets",
    "views",
    "pipeline",
    "topic_integrity"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subject",
        "question",
        "audience",
        "entrypoint"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "subject": {
          "enum": [
            "global_warming",
            "sars_cov_2",
            "world_development_indicators",
            "oil_market",
            "usa_elections_2026",
            "drone_industry"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 10
        },
        "audience": {
          "type": "string",
          "minLength": 3
        },
        "entrypoint": {
          "$ref": "#/$defs/relativePath"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true,
          "default": []
        },
        "sample_environment_variable": {
          "type": "string",
          "const": "DASHBOARD_SAMPLE_MODE",
          "default": "DASHBOARD_SAMPLE_MODE"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "topic_integrity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          },
          {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "title",
        "url",
        "licence",
        "retrieved",
        "cadence",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "licence": {
          "type": "string",
          "minLength": 2
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "cadence": {
          "type": "string",
          "minLength": 2
        },
        "status": {
          "enum": [
            "live",
            "archive",
            "licensed",
            "snapshot"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "role",
        "nullable"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime"
          ]
        },
        "role": {
          "enum": [
            "identifier",
            "dimension",
            "measure",
            "time",
            "geography"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "date_minimum": {"type": "string", "format": "date"},
        "date_maximum": {"type": "string", "format": "date"},
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {"date_column": ["latest_observation"], "latest_observation": ["date_column"]},
      "required": [
        "id",
        "source_ids",
        "sample",
        "processed_output",
        "primary_key",
        "columns"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "sample": {
          "$ref": "#/$defs/relativePath"
        },
        "processed_output": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "enum": [
            "csv",
            "json",
            "parquet"
          ]
        },
        "date_column": {
          "type": "string",
          "minLength": 1
        },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/column"
          }
        },
        "minimum_rows": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "latest_observation": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "label",
        "test_value"
      ],
      "properties": {
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column", "operator"],
          "properties": {
            "column": {"type": "string", "minLength": 1},
            "operator": {"enum": ["isin", "equals", "range", "contains"]}
          }
        },
        "key": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "selectbox",
            "multiselect",
            "radio",
            "slider",
            "date_input",
            "number_input",
            "text_input",
            "checkbox",
            "toggle",
            "button"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "default_value": {},
        "test_value": {},
        "expected_text": {
          "type": "string",
          "minLength": 1
        },
        "empty_test_value": {},
        "empty_expected_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dataset_id",
        "title",
        "unit",
        "source_ids",
        "outputs"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/identifier"},
        "page": {"$ref": "#/$defs/relativePath"},
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          },
          "default": []
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "contains": {"enum": ["chart", "metric", "table"]},
          "items": {
            "enum": ["chart", "metric", "table", "download"]
          },
          "uniqueItems": true
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_method",
        "acquisition_path",
        "transform_command",
        "download_declared",
        "download_label",
        "date_label"
      ],
      "properties": {
        "acquisition_method": {
          "enum": [
            "script",
            "manual",
            "licensed_snapshot"
          ]
        },
        "acquisition_path": {
          "$ref": "#/$defs/relativePath"
        },
        "transform_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "download_declared": {
          "type": "boolean"
        },
        "download_label": {
          "type": "string",
          "minLength": 1
        },
        "date_label": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}
